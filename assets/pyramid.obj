# pyramid.obj - primitive with authored UV coordinates (vt).
#
# V convention: the rasterizer samples v = 0 at the first row of the image file,
# so v = 0 is written along the visually upper edge of each patch.  Textures come
# out upright; Blender shows these UVs mirrored.
#
# Atlas - one rectangle per patch, each keeping the aspect ratio of the patch it
# covers so texels stay square on the model:
#
##   base         u 0.0000..0.2400   v 0.7600..1.0000
#   side 0       u 0.0000..0.2400   v 0.0000..0.2163
#   side 1       u 0.2500..0.4900   v 0.0000..0.2163
#   side 2       u 0.5000..0.7400   v 0.0000..0.2163
#   side 3       u 0.7500..0.9900   v 0.0000..0.2163
#
# The sampler clamps uv to [0, 1] and has no repeat mode, so all coordinates
# stay inside the unit square and every face is used once - nothing tiles.
#
# Vertex positions, normals, face order and winding are unchanged.


# vertices
v -1.0 0.0 -1.0
v  1.0 0.0 -1.0
v  1.0 0.0  1.0
v -1.0 0.0  1.0
v  0.0 1.5  0.0

# normals
vn  0.0 -1.0  0.0
vn  0.0  0.5547 -0.8321
vn  0.8321  0.5547  0.0
vn  0.0  0.5547  0.8321
vn -0.8321  0.5547  0.0

# texture coordinates

# base         u 0.0000..0.2400   v 0.7600..1.0000
vt 0.000000 0.760000
vt 0.240000 1.000000
vt 0.240000 0.760000
vt 0.000000 1.000000

# side 0       u 0.0000..0.2400   v 0.0000..0.2163
vt 0.000000 0.216333
vt 0.240000 0.216333
vt 0.120000 0.000000

# side 1       u 0.2500..0.4900   v 0.0000..0.2163
vt 0.250000 0.216333
vt 0.490000 0.216333
vt 0.370000 0.000000

# side 2       u 0.5000..0.7400   v 0.0000..0.2163
vt 0.500000 0.216333
vt 0.740000 0.216333
vt 0.620000 0.000000

# side 3       u 0.7500..0.9900   v 0.0000..0.2163
vt 0.750000 0.216333
vt 0.990000 0.216333
vt 0.870000 0.000000

# faces
f 1/1/1 3/2/1 2/3/1
f 1/1/1 4/4/1 3/2/1
f 1/5/2 2/6/2 5/7/2
f 2/8/3 3/9/3 5/10/3
f 3/11/4 4/12/4 5/13/4
f 4/14/5 1/15/5 5/16/5
