# cube.obj - primitive with authored UV coordinates (vt).
#
# V convention: the rasterizer samples v = 0 at the first row of the image file,
# so v = 0 is written along the visually upper edge of each patch.  Textures come
# out upright; Blender shows these UVs mirrored.
#
# Atlas - one rectangle per patch, each keeping the aspect ratio of the patch it
# covers so texels stay square on the model:
#
##   -Z face      u 0.6667..1.0000   v 0.0000..0.5000
#   +Z face      u 0.3333..0.6667   v 0.5000..1.0000
#   -X face      u 0.6667..1.0000   v 0.5000..1.0000
#   +X face      u 0.0000..0.3333   v 0.5000..1.0000
#   -Y face      u 0.3333..0.6667   v 0.0000..0.5000
#   +Y face      u 0.0000..0.3333   v 0.0000..0.5000
#
# The sampler clamps uv to [0, 1] and has no repeat mode, so all coordinates
# stay inside the unit square and every face is used once - nothing tiles.
#
# Vertex positions, normals, face order and winding are unchanged.


# vertices
v -1.0 -1.0 -1.0
v  1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v -1.0  1.0 -1.0
v -1.0 -1.0  1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0

# normals
vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0

# texture coordinates

# -Z face      u 0.6667..1.0000   v 0.0000..0.5000
vt 0.666667 0.500000
vt 1.000000 0.000000
vt 1.000000 0.500000
vt 0.666667 0.000000

# +Z face      u 0.3333..0.6667   v 0.5000..1.0000
vt 0.666667 1.000000
vt 0.333333 1.000000
vt 0.333333 0.500000
vt 0.666667 0.500000

# -X face      u 0.6667..1.0000   v 0.5000..1.0000
vt 0.666667 1.000000
vt 1.000000 1.000000
vt 1.000000 0.500000
vt 0.666667 0.500000

# +X face      u 0.0000..0.3333   v 0.5000..1.0000
vt 0.333333 1.000000
vt 0.333333 0.500000
vt 0.000000 0.500000
vt 0.000000 1.000000

# -Y face      u 0.3333..0.6667   v 0.0000..0.5000
vt 0.333333 0.500000
vt 0.666667 0.500000
vt 0.666667 0.000000
vt 0.333333 0.000000

# +Y face      u 0.0000..0.3333   v 0.0000..0.5000
vt 0.000000 0.000000
vt 0.000000 0.500000
vt 0.333333 0.500000
vt 0.333333 0.000000

# faces
f 1/1/1 3/2/1 2/3/1
f 1/1/1 4/4/1 3/2/1
f 5/5/2 6/6/2 7/7/2
f 5/5/2 7/7/2 8/8/2
f 1/9/3 5/10/3 8/11/3
f 1/9/3 8/11/3 4/12/3
f 2/13/4 3/14/4 7/15/4
f 2/13/4 7/15/4 6/16/4
f 1/17/5 2/18/5 6/19/5
f 1/17/5 6/19/5 5/20/5
f 4/21/6 8/22/6 7/23/6
f 4/21/6 7/23/6 3/24/6
